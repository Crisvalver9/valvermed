# Copia este archivo a ".env" para desarrollo local (ya está en .gitignore).
# En Vercel, estas mismas 3 variables se configuran en:
#   Project Settings -> Environment Variables
#
# NUNCA subas el archivo .env ni el JSON de la cuenta de servicio a git.

# Email de la cuenta de servicio (Google Cloud Console > IAM y administración
# > Cuentas de servicio). Ej: calendar-booking@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la cuenta de servicio (campo "private_key" del JSON descargado).
# Pégala completa, con los saltos de línea reemplazados por "\n" literal
# (así es como llega si copias el valor del JSON tal cual). El código en
# api/lib/calendar.js hace el .replace(/\\n/g, '\n') antes de usarla.
# Ejemplo (acortado): "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ID de la agenda de Google Calendar del Dr. Valverde (Configuración de esa
# agenda > "Integrar calendario" > ID del calendario). Si es su calendario
# principal, normalmente es su propio email de Gmail.
GOOGLE_CALENDAR_ID=
